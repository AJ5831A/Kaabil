# ─── Gemini (server only — never exposed to the browser) ─────────────────────
# Without a key, Saathi uses its built-in rule-based engine and the browser voice.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Optional overrides (default to GEMINI_CHAT_MODEL)
GEMINI_STT_MODEL=
GEMINI_TRANSLATE_MODEL=

# ─── Admin / centre-worker sign-in ───────────────────────────────────────────
# AUTH_SECRET (≥16 chars) signs the admin session cookie. Generate: openssl rand -base64 32
# Dev only (NODE_ENV != production) defaults: admin@kaabil.local / kaabil-admin, worker@kaabil.local / kaabil-worker.
# In production these MUST be set; a missing pair disables that login, a missing AUTH_SECRET disables sign-in.
# Details: src/lib/auth/README.md
AUTH_SECRET=
ADMIN_EMAIL=admin@kaabil.local
ADMIN_PASSWORD=
CENTRE_WORKER_EMAIL=worker@kaabil.local
CENTRE_WORKER_PASSWORD=
# Station the centre worker belongs to (scopes report handling to that town)
CENTRE_WORKER_STATION=s1

# ─── Rate limiting (optional; in-memory if unset) ────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Data (pilot JSON store) ─────────────────────────────────────────────────
# Defaults: ./.data locally, /tmp/kaabil on Vercel (ephemeral).
KAABIL_DATA_DIR=

# ─── KAABIL Station (kiosk) ──────────────────────────────────────────────────
# 4-digit helper PIN to exit Station mode. Public by design (it's a pilot deterrent, not a secret).
NEXT_PUBLIC_STATION_PIN=2468
